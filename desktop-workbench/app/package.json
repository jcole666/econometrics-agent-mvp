{
  "name": "econometrics-agent-workbench",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "config": {
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "tsc -p tsconfig.node.json && electron .",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.node.json",
    "package:win": "npm run build && electron-builder --win portable",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "electron": "39.8.10",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.econometrics.agent.workbench",
    "productName": "Econometrics Agent Workbench",
    "electronVersion": "39.8.10",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../sidecar-dist/econometrics-sidecar",
        "to": "sidecar/econometrics-sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Econometrics-Agent-Workbench-${version}-portable.${ext}"
    }
  }
}
